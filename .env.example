# Copy this file to .env and fill in the values before running the app.
#
# DATABASE_URL (production / Vercel): your PostgreSQL connection string,
#   e.g. postgresql://user:password@host:5432/dbname
# The live deployment uses the Postgres database already configured on Vercel.
#
# For local development with SQLite instead, see prisma/schema.local.prisma.
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Secret used by NextAuth to sign session tokens — generate with:
#   openssl rand -base64 32
NEXTAUTH_SECRET="replace-me"

# Base URL where the app runs
NEXTAUTH_URL="http://localhost:3000"
